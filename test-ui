#!/bin/sh
set -eu
THIS=$(CDPATH= cd "$(dirname "$0")" && pwd)
WORK=$(mktemp -d /tmp/partitions-test-ui-XXXXXX)
LOOP=

# This GUI test plans changes on its own loop fixture and verifies no partition-table writes.
finish()
{
   STATUS=$?
   trap - 0
   if [ -n "$LOOP" ]; then
      if mountpoint -q "$WORK/mount"; then
         umount "$WORK/mount"
      fi
      losetup -d "$LOOP"
   fi
   rm -rf "$WORK"
   exit "$STATUS"
}
trap finish 0
trap 'exit 130' INT
trap 'exit 143' TERM

truncate -s 2G "$WORK/disk.img"
printf 'label: gpt\nstart=2048, size=262144\nstart=2097152, size=131072\n' | sfdisk "$WORK/disk.img" > "$WORK/layout.log"
LOOP=$(losetup --find --show --partscan "$WORK/disk.img")
mkfs.ext4 -q "$LOOP"p1
mkdir "$WORK/mount"
mount "$LOOP"p1 "$WORK/mount"
make -C "$THIS" build/partition-manager-ui-test
xvfb-run -a -s '-screen 0 1440x900x24' env G_DEBUG=fatal-criticals "$THIS/build/partition-manager-ui-test" "$LOOP"
truncate -s 128M "$WORK/empty.img"
xvfb-run -a -s '-screen 0 1440x900x24' env G_DEBUG=fatal-criticals "$THIS/build/partition-manager-ui-test" --empty-table "$WORK/empty.img"

# Whole-device FAT can resemble an empty MBR while its mounted filesystem stays in use.
if mountpoint -q "$WORK/mount"; then umount "$WORK/mount"; fi
losetup -d "$LOOP"
truncate -s 128M "$WORK/whole.img"
mkfs.fat -F 32 "$WORK/whole.img"
LOOP=$(losetup --find --show "$WORK/whole.img")
mount "$LOOP" "$WORK/mount"
xvfb-run -a -s '-screen 0 1440x900x24' env G_DEBUG=fatal-criticals "$THIS/build/partition-manager-ui-test" --whole-device "$LOOP"

# Apply reports real phases in a modal progress window, then verifies the actual GPT.
truncate -s 128M "$WORK/apply.img"
xvfb-run -a -s '-screen 0 1440x900x24' env G_DEBUG=fatal-criticals "$THIS/build/partition-manager-ui-test" --apply "$WORK/apply.img"

# Create and remove an independently allocated loop to exercise actual udev notifications.
truncate -s 128M "$WORK/events.img"
xvfb-run -a -s '-screen 0 1440x900x24' env G_DEBUG=fatal-criticals "$THIS/build/partition-manager-ui-test" --events "$WORK/events.img"
